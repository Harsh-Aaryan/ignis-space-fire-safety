# Research demonstration uses the in-repo synthetic catalog.
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_ASSISTANT_PROVIDER=mock

# Ask IGNIS is separate from the synthetic research briefing above.
# Copy to .env.local and add the key there. Never use a NEXT_PUBLIC_ prefix for secrets.
# Use "local" to disable external calls. Missing keys fall back to local explanations.
IGNIS_CHAT_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Future database/provider integration for the research demonstration only.
# IGNIS_DATABASE_URL=
# IGNIS_LLM_API_KEY=
