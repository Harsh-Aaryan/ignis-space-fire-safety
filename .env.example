# Ask IGNIS, the scenario assistant.
# Copy this file to .env.local and add the key there. Never give a secret a NEXT_PUBLIC_ prefix.
# Set IGNIS_CHAT_PROVIDER=local to disable external calls. Without a key, answers come from the local explainer.
# Research questions are answered from local retrieval over the research index and the NASA PSI corpus either way.
# scripts/NASAflamesRAG.py query reads GROQ_API_KEY and GROQ_MODEL from the shell environment, not from this file.
IGNIS_CHAT_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
