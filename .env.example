# Ask IGNIS, the scenario assistant.
# Copy this file to .env.local and add the key there. Never give a secret a NEXT_PUBLIC_ prefix.
# Set IGNIS_CHAT_PROVIDER=local to disable external calls. Without a key, answers come from the local explainer.
IGNIS_CHAT_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
